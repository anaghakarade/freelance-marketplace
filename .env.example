# WorkStream Client Environment Variables
# Copy this file to .env for local development

# Go Backend API base URL (WorkStream backend, Phase 3+)
VITE_API_BASE_URL=http://localhost:8081/api

# Future: Stripe publishable key (Phase 4B)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# NEVER expose server-side secrets in frontend code:
# STRIPE_SECRET_KEY, JWT_SECRET, DATABASE_PASSWORD → keep in backend/.env only
