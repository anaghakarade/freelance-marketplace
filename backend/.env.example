# ==============================================================================
# WorkStream Backend Environment Configuration (Phase 11 Production Hardened)
# ==============================================================================

# Server Environment: 'development' or 'production'
ENVIRONMENT=development
PORT=8081

# PostgreSQL Database Configuration
# Option A: Unified Connection URL (Render, Railway, Supabase, Neon)
# DATABASE_URL=postgres://workstream:your_password@ep-host.region.provider.com:5432/workstream?sslmode=require

# Option B: Discrete Parameters (Local development or custom VPS)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_db_password_here
DATABASE_NAME=workstream
# In production, set DATABASE_SSLMODE=require or verify-full
DATABASE_SSLMODE=disable

# CORS Allowed Origins (comma-separated URLs, never use '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication Configuration
# Generate a cryptographically secure key: openssl rand -hex 32 (minimum 32 characters)
# IMPORTANT: Never commit actual JWT_SECRET to source control!
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-change-this
JWT_EXPIRATION_HOURS=24

# Security Hardening & Rate Limiting (Single-instance token-bucket limits)
# AUTH_RATE_LIMIT_RPM: Requests per minute permitted on /api/auth/login and /register (default: 60)
AUTH_RATE_LIMIT_RPM=60
# REPORT_RATE_LIMIT_RPM: Requests per minute permitted on /api/reports (default: 30)
REPORT_RATE_LIMIT_RPM=30
# MAX_REQUEST_BODY_BYTES: Maximum allowed request payload in bytes (default: 2097152 = 2MB)
MAX_REQUEST_BODY_BYTES=2097152
